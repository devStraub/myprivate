# Copie para secrets.cfg e preencha. Nunca envie secrets.cfg ao Git.
sv_licenseKey "COLOQUE_A_CHAVE_CFX_AQUI"
set steam_webApiKey "COLOQUE_A_CHAVE_STEAM_AQUI"
set sv_enforceSteamAuth false

# Codifique caracteres especiais da senha como URL.
# Exemplo: mysql://usuario:senha@127.0.0.1/fipas_roleplay?charset=utf8mb4
set mysql_connection_string "mysql://rsg:ALTERE_A_SENHA@127.0.0.1/fipas_roleplay?charset=utf8mb4"
